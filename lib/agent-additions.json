 "glossary": [
  [
   "Temperature",
   "A setting that controls how creative or predictable an AI's answers are. Low = safe and consistent, high = more varied."
  ],
  [
   "Inference",
   "Using a trained AI model to get an answer. Every time you send a prompt, the model runs inference."
  ],
  [
   "Parameters",
   "The millions or billions of numbers inside a model that it learned during training. More parameters usually means a bigger, more capable model."
  ],
  [
   "Reasoning model",
   "An AI model that \"thinks\" step by step before answering, which helps with maths, code and planning but takes longer."
  ],
  [
   "Transformer",
   "The design behind almost all modern language models. It lets the model look at every word in a sentence at once to understand context."
  ],
  [
   "System prompt",
   "Hidden instructions given to an AI before your message, setting its role, tone and rules."
  ],
  [
   "Few-shot prompting",
   "Showing the AI a few examples of what you want inside your prompt so it copies the pattern."
  ],
  [
   "Guardrails",
   "Rules and checks around an AI app that block unsafe, off-topic or wrong outputs."
  ],
  [
   "Benchmark",
   "A standard test used to compare AI models, like an exam everyone takes."
  ],
  [
   "Overfitting",
   "When a model memorises its training examples instead of learning general patterns, so it does badly on new data."
  ],
  [
   "Quantization",
   "Shrinking a model by storing its numbers with less precision, so it runs faster on smaller computers with a small quality loss."
  ],
  [
   "Distillation",
   "Training a small, cheap model to copy the answers of a big model."
  ],
  [
   "Grounding",
   "Making an AI base its answer on specific trusted sources (like your documents) instead of only its memory."
  ],
  [
   "Knowledge cutoff",
   "The date after which a model has no training data, so it doesn't know about later events unless given search or documents."
  ],
  [
   "Human in the loop",
   "A setup where a person reviews or approves the AI's work before it takes effect."
  ],
  [
   "Deepfake",
   "A fake image, video or voice made with AI to look or sound like a real person."
  ],
  [
   "Synthetic data",
   "Artificial data created by computers or AI, used to train or test models when real data is scarce or private."
  ],
  [
   "AGI",
   "Artificial general intelligence: a hypothetical AI that can learn and do almost any intellectual task a person can."
  ]
 ],
