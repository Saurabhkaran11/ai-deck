# Level 4 · Build AI apps agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=level-4
AGENT_NAME="Level 4 · Build AI apps agent"
AGENT_SCOPE=level
LEVEL=4
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=vectordb,evals,finetune,multiagent,a2a,scale
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=course,paid,video,repo
# Preferred sources when researching
TRUSTED_DOMAINS=huggingface.co,deeplearning.ai,github.com,docs.ragas.io,promptfoo.dev,learn.microsoft.com,skillbuilder.aws,youtube.com
RESEARCH_FOCUS="Free courses, YouTube videos, open-source repos and one best paid option for Level 4 (Build AI apps: Search, testing, custom models and teams of agents). Beginner-friendly, current in 2026."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
