# Level 5 · More AI fields agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=level-5
AGENT_NAME="Level 5 · More AI fields agent"
AGENT_SCOPE=level
LEVEL=5
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=vision,speech,genmedia,multimodal,recsys,timeseries,robotics
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=course,paid,video,repo
# Preferred sources when researching
TRUSTED_DOMAINS=huggingface.co,pytorch.org,opencv.org,kaggle.com,developers.google.com,github.com,youtube.com
RESEARCH_FOCUS="Free courses, YouTube videos, open-source repos and one best paid option for Level 5 (More AI fields: AI beyond text: vision, voice, image and video generation, recommendations, forecasting and robots). Beginner-friendly, current in 2026."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
