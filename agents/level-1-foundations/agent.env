# Level 1 · Foundations agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=level-1
AGENT_NAME="Level 1 · Foundations agent"
AGENT_SCOPE=level
LEVEL=1
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=ai-intro,python,math,data,ml-basics,neural-nets
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=course,paid,video,repo
# Preferred sources when researching
TRUSTED_DOMAINS=elementsofai.com,kaggle.com,developers.google.com,khanacademy.org,3blue1brown.com,cs50.harvard.edu,fast.ai,huggingface.co,youtube.com
RESEARCH_FOCUS="Free courses, YouTube videos, open-source repos and one best paid option for Level 1 (Foundations: What AI is, plus the Python, maths, data and machine-learning basics underneath it). Beginner-friendly, current in 2026."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
