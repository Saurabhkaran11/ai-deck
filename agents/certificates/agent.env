# Certificates agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=certificates
AGENT_NAME="Certificates agent"
AGENT_SCOPE=feature
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=*
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=badge
# Preferred sources when researching
TRUSTED_DOMAINS=skillbuilder.aws,aws.amazon.com,learn.microsoft.com,academy.openai.com,anthropic.skilljar.com,huggingface.co,cloudskillsboost.google,skills.google,nvidia.com,kaggle.com,ibm.com
RESEARCH_FOCUS="Free certificates and badges from AWS, Microsoft Learn, OpenAI, Anthropic, Google, Hugging Face, NVIDIA, IBM and Kaggle, attached to the most relevant topic id. Flag paid exams with paid=true. Skip retired exams."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
