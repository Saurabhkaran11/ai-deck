# Level 8 · Specialist topics agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=level-8
AGENT_NAME="Level 8 · Specialist topics agent"
AGENT_SCOPE=level
LEVEL=8
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=mlops,data-eng,nlp,xai,kg,gnn,synthetic,privacy-ml,edge-ai,ai-chips,quantum-ml,papers
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=course,paid,video,repo
# Preferred sources when researching
TRUSTED_DOMAINS=madewithml.com,github.com,huggingface.co,pytorch.org,cs.stanford.edu,arxiv.org,learn.microsoft.com,youtube.com
RESEARCH_FOCUS="Free courses, YouTube videos, open-source repos and one best paid option for Level 8 (Specialist topics: MLOps, data engineering, NLP, explainable AI, knowledge graphs, graph networks, synthetic data, privacy, edge AI, chips, quantum and reading papers). Beginner-friendly, current in 2026."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
