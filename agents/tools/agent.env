# AI Tools agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=tools
AGENT_NAME="AI Tools agent"
AGENT_SCOPE=feature
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=t-chat,t-models,t-coding,t-frameworks,t-protocols,t-automation,t-vector,t-evals,t-finetune,t-inference,t-cloud,t-media,t-productivity,t-browser
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=tool
# Preferred sources when researching
TRUSTED_DOMAINS=github.com,huggingface.co,producthunt.com,theresanaiforthat.com
RESEARCH_FOCUS="New and notable AI tools, frameworks and apps (2025–2026) for each tool category. Mark open-source vs free vs freemium vs paid accurately, with current prices."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
