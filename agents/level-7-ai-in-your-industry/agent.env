# Level 7 · AI in your industry agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=level-7
AGENT_NAME="Level 7 · AI in your industry agent"
AGENT_SCOPE=level
LEVEL=7
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=ind-health,ind-finance,ind-legal,ind-education,ind-retail,ind-manufacturing,ind-agriculture,ind-marketing,ind-hr,ind-gov
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=course,paid,video,repo
# Preferred sources when researching
TRUSTED_DOMAINS=coursera.org,edx.org,microsoft.com,learn.microsoft.com,skillbuilder.aws,nvidia.com,who.int,youtube.com
RESEARCH_FOCUS="Free courses, YouTube videos, open-source repos and one best paid option for Level 7 (AI in your industry: How AI is used in healthcare, finance, law, education, retail, factories, farming, marketing, HR and government, and the rules for each). Beginner-friendly, current in 2026."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
