# Level 6 · Responsible AI & business agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=level-6
AGENT_NAME="Level 6 · Responsible AI & business agent"
AGENT_SCOPE=level
LEVEL=6
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=ethics,safety,ai-law,ai-business,ai-product
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=course,paid,video,repo
# Preferred sources when researching
TRUSTED_DOMAINS=oecd.ai,nist.gov,artificialintelligenceact.eu,coursera.org,edx.org,iapp.org,ibm.com,youtube.com
RESEARCH_FOCUS="Free courses, YouTube videos, open-source repos and one best paid option for Level 6 (Responsible AI & business: Use AI fairly, safely and legally, and turn it into real business value). Beginner-friendly, current in 2026."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
