# Copy to agents/.env (git-ignored) and fill in. Only needed for `research` / `run`.
# Get a key at https://console.anthropic.com/  (pay-as-you-go; a research run per agent costs a few cents)
ANTHROPIC_API_KEY=
# Model used for research (web search tool enabled)
ANTHROPIC_MODEL=claude-sonnet-5-5
RESEARCH_MAX_SEARCHES=8
RESEARCH_MAX_TOKENS=8000
