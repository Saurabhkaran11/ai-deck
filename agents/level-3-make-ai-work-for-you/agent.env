# Level 3 · Make AI work for you agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=level-3
AGENT_NAME="Level 3 · Make AI work for you agent"
AGENT_SCOPE=level
LEVEL=3
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=rag,memory,mcp,patterns,design
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=course,paid,video,repo
# Preferred sources when researching
TRUSTED_DOMAINS=docs.llamaindex.ai,langchain-ai.github.io,modelcontextprotocol.io,huggingface.co,deeplearning.ai,learn.microsoft.com,github.com,youtube.com
RESEARCH_FOCUS="Free courses, YouTube videos, open-source repos and one best paid option for Level 3 (Make AI work for you: Connect AI to your documents, apps and memory so it does real work). Beginner-friendly, current in 2026."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
