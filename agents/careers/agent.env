# Careers agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=careers
AGENT_NAME="Careers agent"
AGENT_SCOPE=feature
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=ai-engineer,ml-engineer,mlops-engineer,swe-ai,data-scientist,data-engineer,ai-pm,solutions-architect,prompt-engineer,researcher,cv-engineer,nlp-engineer,responsible-ai,ai-security,ai-literacy,robotics-engineer
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=step
# Preferred sources when researching
TRUSTED_DOMAINS=coursera.org,edx.org,deeplearning.ai,learn.microsoft.com,skillbuilder.aws,huggingface.co,madewithml.com,datatalks.club
RESEARCH_FOCUS="Courses that move a learner along a specific AI job track. Free first, then the single best paid credential."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
