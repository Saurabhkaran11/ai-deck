# Level 2 · AI basics agent
# Own config for this agent. Safe to commit: no secrets here (the API key lives in agents/.env).
AGENT_ID=level-2
AGENT_NAME="Level 2 · AI basics agent"
AGENT_SCOPE=level
LEVEL=2
# Site ids this agent owns (topic ids, tool group ids, track ids, or * for all topics)
TARGETS=chat,prompting,llm,context,agents
# What it may add: course, paid, video, repo, badge, tool, glossary, step, project
RESOURCE_KINDS=course,paid,video,repo
# Preferred sources when researching
TRUSTED_DOMAINS=huggingface.co,anthropic.skilljar.com,academy.openai.com,deeplearning.ai,docs.claude.com,platform.openai.com,promptingguide.ai,youtube.com
RESEARCH_FOCUS="Free courses, YouTube videos, open-source repos and one best paid option for Level 2 (AI basics: How chatbots and AI models work, and how to get good answers from them). Beginner-friendly, current in 2026."
# Max new candidates per research run
MAX_NEW_PER_RUN=8
# true = approve candidates automatically when their link checks out (default: manual review)
AUTO_APPROVE=false
# Where this agent keeps its resources (append-only)
REGISTRY_FILE=resources.json
